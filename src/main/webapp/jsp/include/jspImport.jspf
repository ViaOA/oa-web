<%-- OAWeb hierarchy: System/Application/Session/Form --%>
<jsp:useBean id="oasystem" scope="application" class="com.viaoa.web.server.OASystem" />

<%!static Logger LOG = Logger.getLogger("oaweb");%>
<%
    String applicationId = "oaweb";
    OAApplication oaapplication = oasystem.getApplication(applicationId, application);
    OASession oasession = oaapplication.getSession(session);
    oasession.setResponse(response);
    oasession.setRequest(request);
    
    String formId = "";
    OAForm form = null;

    request.setCharacterEncoding("UTF-8");

    OAWebApp webApp = (OAWebApp) oasession.get("OAWebApp");
%>

